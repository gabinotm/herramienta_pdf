# Configuración para hosting Apache / cPanel (opcional pero recomendada)

# Tipos de archivo necesarios
AddType application/wasm .wasm
AddType text/javascript .js .mjs
AddType font/woff2 .woff2
AddType application/octet-stream .bcmap .pfb

# Seguridad
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Caché: las librerías de /vendor tienen versión fija y pueden guardarse mucho tiempo
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 1 hour"
    ExpiresByType text/css "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/?(.*/)?vendor/#">
        Header set Cache-Control "public, max-age=2592000"
    </If>
</IfModule>

# Compresión
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/wasm application/json
</IfModule>

# No publicar archivos de desarrollo si se suben por error
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)(node_modules|tests|tools|\.git)(/|$) - [F,L]
    RewriteRule (^|/)(package(-lock)?\.json|playwright\.config\.js|eslint\.config\.js)$ - [F,L]
</IfModule>
